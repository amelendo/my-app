# Token public Mapbox — restreindre par URL dans le dashboard Mapbox
VITE_MAPBOX_TOKEN=pk.your_public_token_here

# Strava — Client ID public (exposé côté front, c'est normal)
VITE_STRAVA_CLIENT_ID=12345

# Strava — Client Secret : NE JAMAIS préfixer par VITE_ (doit rester serveur).
# À définir dans les Environment Variables Vercel, pas dans le bundle front.
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=your_strava_client_secret
